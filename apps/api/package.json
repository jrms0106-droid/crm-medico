{
  "name": "@crm/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "dev": "tsc -b && concurrently -k -n tsc,api \"tsc -b -w --preserveWatchOutput\" \"node --env-file=../../.env --enable-source-maps --watch dist/main.js\"",
    "start": "node --enable-source-maps dist/main.js"
  },
  "devDependencies": {
    "@nestjs/testing": "12.2.0",
    "@swc/core": "1.16.20",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "concurrently": "10.0.6",
    "supertest": "7.3.1",
    "unplugin-swc": "2.0.0"
  },
  "dependencies": {
    "@crm/policy": "*",
    "@crm/shared": "*",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "0.45.1",
    "cookie-parser": "1.4.7",
    "helmet": "8.3.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  }
}
