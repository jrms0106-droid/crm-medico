{
  "name": "crm-medico",
  "private": true,
  "version": "0.0.0",
  "description": "CRM médico multiespecialidades com prontuário eletrônico. Em desenvolvimento: não apto a uso clínico real.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev --workspace @crm/api & npm run dev --workspace @crm/web",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p scripts/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "tsx scripts/seed.ts",
    "postinstall": "prisma generate"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "dotenv": "^18.0.8",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prisma": "7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  },
  "type": "module"
}
