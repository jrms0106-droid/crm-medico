# Copie para .env e ajuste. NUNCA coloque credenciais reais neste arquivo.
# Banco local de desenvolvimento (dados fictícios apenas)
DATABASE_URL="postgresql://crm:crm_dev_only@localhost:5432/crm_dev"
# Banco usado pelos testes de integração (é apagado e recriado pelos testes)
DATABASE_URL_TEST="postgresql://crm:crm_dev_only@localhost:5432/crm_test"
API_PORT=3000
WEB_ORIGIN="http://localhost:5173"
# Chave para criptografar segredos de MFA (32 bytes em base64). Gere a sua: openssl rand -base64 32
# O valor abaixo é público e serve SÓ para desenvolvimento e testes.
MFA_ENCRYPTION_KEY="ZGV2LXNvbWVudGUtbmFvLXVzYXItZW0tcHJvZHVjYW8="
# Chave para criptografar dados pessoais sensíveis, como o CPF (32 bytes em base64).
# O valor abaixo é público e serve SÓ para desenvolvimento e testes. Gere a sua: openssl rand -base64 32
PII_ENCRYPTION_KEY="cGlpLWRldi1zb21lbnRlLW5hby11c2FyLWVtLXByb2Q="
# Cookies só por HTTPS. Em produção é sempre true; em desenvolvimento local (http) use false.
COOKIE_SECURE=false
