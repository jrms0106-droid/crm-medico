// Esquema do banco. Cada módulo do sistema tem seu próprio schema no PostgreSQL
// (ver docs/planejamento/03-arquitetura.md, seção 2). Toda alteração vira uma
// migração versionada em prisma/migrations.

generator client {
  provider            = "prisma-client"
  output              = "../apps/api/src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["org", "identity"]
}

/// Organização (pessoa jurídica controladora dos dados).
model Organization {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String   @db.VarChar(200)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  units     Unit[]
  users     User[]

  @@map("organizations")
  @@schema("org")
}

/// Unidade de atendimento. Todo dado operacional carrega o id da unidade.
model Unit {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name           String       @db.VarChar(200)
  timezone       String       @default("America/Sao_Paulo") @db.VarChar(64)
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("units")
  @@schema("org")
}

enum Role {
  doctor
  secretary
  admin

  @@schema("identity")
}

/// Pessoa que acessa o sistema. Senha guardada só como hash Argon2id.
model User {
  id                 String       @id @default(uuid(7)) @db.Uuid
  organizationId     String       @map("organization_id") @db.Uuid
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name               String       @db.VarChar(200)
  /// Sempre em minúsculas.
  email              String       @unique @db.VarChar(254)
  passwordHash       String       @map("password_hash") @db.VarChar(255)
  roles              Role[]
  active             Boolean      @default(true)
  mustChangePassword Boolean      @default(false) @map("must_change_password")
  /// Segredo TOTP criptografado com AES-256-GCM (nunca em texto puro).
  mfaSecretEnc       String?      @map("mfa_secret_enc") @db.VarChar(255)
  mfaEnabled         Boolean      @default(false) @map("mfa_enabled")
  /// Último passo de 30 s aceito; impede reutilizar o mesmo código.
  mfaLastStep        BigInt?      @map("mfa_last_step")
  failedLoginCount   Int          @default(0) @map("failed_login_count")
  lockedUntil        DateTime?    @map("locked_until") @db.Timestamptz(3)
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions           Session[]

  @@index([organizationId])
  @@map("users")
  @@schema("identity")
}

/// Sessão de login. Guarda apenas o hash do token; o token fica só no cookie do navegador.
model Session {
  id            String    @id @default(uuid(7)) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash     String    @unique @map("token_hash") @db.Char(64)
  csrfToken     String    @map("csrf_token") @db.VarChar(64)
  mfaVerified   Boolean   @default(false) @map("mfa_verified")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt    DateTime  @map("last_seen_at") @db.Timestamptz(3)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(3)
  reauthAt      DateTime? @map("reauth_at") @db.Timestamptz(3)
  ip            String?   @db.VarChar(64)
  userAgent     String?   @map("user_agent") @db.VarChar(400)

  @@index([userId])
  @@map("sessions")
  @@schema("identity")
}
