// Esquema do banco. Cada módulo do sistema tem seu próprio schema no PostgreSQL
// (ver docs/planejamento/03-arquitetura.md, seção 2). Toda alteração vira uma
// migração versionada em prisma/migrations.

generator client {
  provider            = "prisma-client"
  output              = "../apps/api/src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["org", "identity", "audit", "patients", "scheduling", "care", "records", "documents", "billing", "privacy", "crm", "ai"]
}

/// Organização (pessoa jurídica controladora dos dados).
model Organization {
  id            String             @id @default(uuid(7)) @db.Uuid
  name          String             @db.VarChar(200)
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  units         Unit[]
  users         User[]
  specialties   Specialty[]
  professionals Professional[]
  patients      Patient[]
  aiSettings    AiFeatureSetting[]
  aiRequests    AiRequest[]

  @@map("organizations")
  @@schema("org")
}

/// Unidade de atendimento. Todo dado operacional carrega o id da unidade.
model Unit {
  id             String           @id @default(uuid(7)) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name           String           @db.VarChar(200)
  timezone       String           @default("America/Sao_Paulo") @db.VarChar(64)
  active         Boolean          @default(true)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  memberships    UnitMembership[]
  schedules      Schedule[]
  waitlist       WaitlistEntry[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("units")
  @@schema("org")
}

enum Role {
  doctor
  secretary
  admin

  @@schema("identity")
}

/// Pessoa que acessa o sistema. Senha guardada só como hash Argon2id.
model User {
  id                 String             @id @default(uuid(7)) @db.Uuid
  organizationId     String             @map("organization_id") @db.Uuid
  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name               String             @db.VarChar(200)
  /// Sempre em minúsculas.
  email              String             @unique @db.VarChar(254)
  passwordHash       String             @map("password_hash") @db.VarChar(255)
  roles              Role[]
  active             Boolean            @default(true)
  mustChangePassword Boolean            @default(false) @map("must_change_password")
  /// Segredo TOTP criptografado com AES-256-GCM (nunca em texto puro).
  mfaSecretEnc       String?            @map("mfa_secret_enc") @db.VarChar(255)
  mfaEnabled         Boolean            @default(false) @map("mfa_enabled")
  /// Último passo de 30 s aceito; impede reutilizar o mesmo código.
  mfaLastStep        BigInt?            @map("mfa_last_step")
  failedLoginCount   Int                @default(0) @map("failed_login_count")
  lockedUntil        DateTime?          @map("locked_until") @db.Timestamptz(3)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions           Session[]
  aiSettingsUpdated  AiFeatureSetting[]
  aiRequests         AiRequest[]        @relation("AiRequestUser")
  aiDecisions        AiRequest[]        @relation("AiRequestDecidedBy")
  unitMemberships    UnitMembership[]
  professional       Professional?

  @@index([organizationId])
  @@map("users")
  @@schema("identity")
}

/// Sessão de login. Guarda apenas o hash do token; o token fica só no cookie do navegador.
model Session {
  id          String    @id @default(uuid(7)) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique @map("token_hash") @db.Char(64)
  csrfToken   String    @map("csrf_token") @db.VarChar(64)
  mfaVerified Boolean   @default(false) @map("mfa_verified")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt  DateTime  @map("last_seen_at") @db.Timestamptz(3)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)
  reauthAt    DateTime? @map("reauth_at") @db.Timestamptz(3)
  ip          String?   @db.VarChar(64)
  userAgent   String?   @map("user_agent") @db.VarChar(400)

  @@index([userId])
  @@map("sessions")
  @@schema("identity")
}

/// Vínculo de um usuário com uma unidade. Recursos operacionais da unidade exigem este vínculo.
model UnitMembership {
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  unitId    String   @map("unit_id") @db.Uuid
  unit      Unit     @relation(fields: [unitId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([userId, unitId])
  @@index([unitId])
  @@map("unit_memberships")
  @@schema("org")
}

/// Especialidade médica do catálogo da organização.
model Specialty {
  id             String                  @id @default(uuid(7)) @db.Uuid
  organizationId String                  @map("organization_id") @db.Uuid
  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name           String                  @db.VarChar(120)
  active         Boolean                 @default(true)
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  professionals  ProfessionalSpecialty[]

  @@unique([organizationId, name])
  @@map("specialties")
  @@schema("org")
}

/// Ficha profissional de um usuário médico: CRM/UF e especialidades com RQE.
model Professional {
  id             String                  @id @default(uuid(7)) @db.Uuid
  organizationId String                  @map("organization_id") @db.Uuid
  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  userId         String                  @unique @map("user_id") @db.Uuid
  user           User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  /// Só dígitos.
  crmNumber      String                  @map("crm_number") @db.VarChar(10)
  /// Sigla da UF em maiúsculas.
  crmState       String                  @map("crm_state") @db.Char(2)
  active         Boolean                 @default(true)
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  specialties    ProfessionalSpecialty[]
  schedules      Schedule[]
  waitlist       WaitlistEntry[]

  @@unique([organizationId, crmState, crmNumber])
  @@map("professionals")
  @@schema("org")
}

model ProfessionalSpecialty {
  professionalId String       @map("professional_id") @db.Uuid
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  specialtyId    String       @map("specialty_id") @db.Uuid
  specialty      Specialty    @relation(fields: [specialtyId], references: [id], onDelete: Restrict)
  /// Registro de Qualificação de Especialista, quando houver. Só dígitos.
  rqe            String?      @db.VarChar(10)

  @@id([professionalId, specialtyId])
  @@index([specialtyId])
  @@map("professional_specialties")
  @@schema("org")
}

enum AuditOutcome {
  allowed
  denied
  not_found

  @@schema("audit")
}

/// Trilha de auditoria somente-acréscimo (um gatilho recusa UPDATE e DELETE).
/// Referencia tudo por id, sem chaves estrangeiras, para sobreviver a qualquer outro dado.
/// Nunca guarda conteúdo clínico.
model AuditEvent {
  id             String       @id @default(uuid(7)) @db.Uuid
  /// Ordem de gravação, estritamente crescente (base do encadeamento por hash na Etapa 7).
  seq            BigInt       @unique @default(autoincrement())
  occurredAt     DateTime     @map("occurred_at") @db.Timestamptz(3)
  organizationId String?      @map("organization_id") @db.Uuid
  actorUserId    String?      @map("actor_user_id") @db.Uuid
  sessionId      String?      @map("session_id") @db.Uuid
  requestId      String?      @map("request_id") @db.VarChar(64)
  ip             String?      @db.VarChar(64)
  action         String       @db.VarChar(32)
  resourceType   String       @map("resource_type") @db.VarChar(64)
  resourceId     String?      @map("resource_id") @db.VarChar(64)
  unitId         String?      @map("unit_id") @db.Uuid
  patientId      String?      @map("patient_id") @db.Uuid
  outcome        AuditOutcome
  reason         String       @db.VarChar(100)
  emergency      Boolean      @default(false)
  /// Posição na cadeia da organização, preenchida pelo gatilho `audit.chain_event`.
  chainSeq       BigInt       @default(dbgenerated("0")) @map("chain_seq")
  /// Resumo do evento anterior da cadeia (vazio no primeiro).
  prevHash       String?      @map("prev_hash") @db.Char(64)
  /// SHA-256 do evento, calculado pelo banco (docs/api/auditoria.md).
  hash           String       @default(dbgenerated("''::bpchar")) @db.Char(64)

  @@index([organizationId, chainSeq])
  @@index([organizationId, occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([patientId, occurredAt])
  @@map("events")
  @@schema("audit")
}

enum CommChannel {
  whatsapp
  sms
  email
  phone

  @@schema("patients")
}

/// Cadastro do paciente (dado pessoal, nunca clínico). Ver docs/api/pacientes.md.
model Patient {
  id                   String            @id @default(uuid(7)) @db.Uuid
  organizationId       String            @map("organization_id") @db.Uuid
  organization         Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  fullName             String            @map("full_name") @db.VarChar(200)
  socialName           String?           @map("social_name") @db.VarChar(200)
  /// Nome completo e social sem acentos, em minúsculas, para a busca.
  nameSearch           String            @map("name_search") @db.VarChar(410)
  /// CPF criptografado (AES-256-GCM). Nunca em texto puro.
  cpfEnc               String?           @map("cpf_enc") @db.VarChar(255)
  /// HMAC-SHA256 do CPF: impede repetição e permite busca exata.
  cpfHash              String?           @map("cpf_hash") @db.Char(64)
  birthDate            DateTime          @map("birth_date") @db.Date
  email                String?           @db.VarChar(254)
  addressZip           String?           @map("address_zip") @db.Char(8)
  addressStreet        String?           @map("address_street") @db.VarChar(200)
  addressNumber        String?           @map("address_number") @db.VarChar(20)
  addressComplement    String?           @map("address_complement") @db.VarChar(100)
  addressDistrict      String?           @map("address_district") @db.VarChar(100)
  addressCity          String?           @map("address_city") @db.VarChar(100)
  addressState         String?           @map("address_state") @db.Char(2)
  commChannels         CommChannel[]     @default([]) @map("comm_channels")
  appointmentReminders Boolean           @default(false) @map("appointment_reminders")
  marketingOptIn       Boolean           @default(false) @map("marketing_opt_in")
  active               Boolean           @default(true)
  version              Int               @default(1)
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  phones               PatientPhone[]
  contacts             PatientContact[]
  versions             PatientVersion[]
  appointments         Appointment[]
  waitlist             WaitlistEntry[]
  encounters           Encounter[]
  emergencyAccesses    EmergencyAccess[]
  clinicalRecords      ClinicalRecord[]
  medicalDocuments     MedicalDocument[]
  charges              Charge[]
  subjectRequests      SubjectRequest[]
  messages             OutboundMessage[]

  @@unique([organizationId, cpfHash])
  @@index([organizationId, birthDate])
  @@index([organizationId, nameSearch])
  @@map("patients")
  @@schema("patients")
}

model PatientPhone {
  id        String  @id @default(uuid(7)) @db.Uuid
  patientId String  @map("patient_id") @db.Uuid
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  /// DDD + número, só dígitos.
  number    String  @db.VarChar(11)
  whatsapp  Boolean @default(false)
  position  Int

  @@unique([patientId, position])
  @@index([number])
  @@map("phones")
  @@schema("patients")
}

enum PatientContactKind {
  guardian
  emergency

  @@schema("patients")
}

/// Responsável legal ou contato de emergência.
model PatientContact {
  id           String             @id @default(uuid(7)) @db.Uuid
  patientId    String             @map("patient_id") @db.Uuid
  patient      Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  kind         PatientContactKind
  name         String             @db.VarChar(200)
  relationship String             @db.VarChar(60)
  phone        String?            @db.VarChar(11)
  email        String?            @db.VarChar(254)
  position     Int

  @@unique([patientId, kind, position])
  @@map("contacts")
  @@schema("patients")
}

/// Versões do cadastro, somente-acréscimo (um gatilho recusa UPDATE e DELETE).
model PatientVersion {
  id              String   @id @default(uuid(7)) @db.Uuid
  patientId       String   @map("patient_id") @db.Uuid
  patient         Patient  @relation(fields: [patientId], references: [id], onDelete: Restrict)
  version         Int
  changedAt       DateTime @map("changed_at") @db.Timestamptz(3)
  changedByUserId String   @map("changed_by_user_id") @db.Uuid
  changedFields   String[] @map("changed_fields")
  /// Fotografia do cadastro após a alteração, sem o CPF.
  snapshot        Json

  @@unique([patientId, version])
  @@map("versions")
  @@schema("patients")
}

/// Agenda de um profissional numa unidade. Ver docs/api/agenda.md.
model Schedule {
  id             String          @id @default(uuid(7)) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  unitId         String          @map("unit_id") @db.Uuid
  unit           Unit            @relation(fields: [unitId], references: [id], onDelete: Restrict)
  professionalId String          @map("professional_id") @db.Uuid
  professional   Professional    @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  slotMinutes    Int             @default(30) @map("slot_minutes")
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  rules          ScheduleRule[]
  blocks         ScheduleBlock[]
  appointments   Appointment[]

  @@unique([unitId, professionalId])
  @@index([organizationId])
  @@map("schedules")
  @@schema("scheduling")
}

/// Faixa de atendimento semanal, em minutos desde a meia-noite na hora local da unidade.
model ScheduleRule {
  id          String   @id @default(uuid(7)) @db.Uuid
  scheduleId  String   @map("schedule_id") @db.Uuid
  schedule    Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  /// 0 = domingo ... 6 = sábado.
  weekday     Int      @db.SmallInt
  startMinute Int      @map("start_minute") @db.SmallInt
  endMinute   Int      @map("end_minute") @db.SmallInt

  @@index([scheduleId, weekday])
  @@map("schedule_rules")
  @@schema("scheduling")
}

model ScheduleBlock {
  id              String    @id @default(uuid(7)) @db.Uuid
  scheduleId      String    @map("schedule_id") @db.Uuid
  schedule        Schedule  @relation(fields: [scheduleId], references: [id], onDelete: Restrict)
  startsAt        DateTime  @map("starts_at") @db.Timestamptz(3)
  endsAt          DateTime  @map("ends_at") @db.Timestamptz(3)
  reason          String    @db.VarChar(200)
  createdByUserId String    @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  removedAt       DateTime? @map("removed_at") @db.Timestamptz(3)
  removedByUserId String?   @map("removed_by_user_id") @db.Uuid

  @@index([scheduleId, startsAt])
  @@map("schedule_blocks")
  @@schema("scheduling")
}

enum AppointmentKind {
  regular
  return
  fit_in

  @@schema("scheduling")
}

enum AppointmentStatus {
  scheduled
  confirmed
  arrived
  cancelled
  no_show
  rescheduled

  @@schema("scheduling")
}

/// Consulta marcada. Sobreposição na mesma agenda é barrada no banco (EXCLUDE USING gist).
model Appointment {
  id                String             @id @default(uuid(7)) @db.Uuid
  organizationId    String             @map("organization_id") @db.Uuid
  unitId            String             @map("unit_id") @db.Uuid
  scheduleId        String             @map("schedule_id") @db.Uuid
  schedule          Schedule           @relation(fields: [scheduleId], references: [id], onDelete: Restrict)
  patientId         String             @map("patient_id") @db.Uuid
  patient           Patient            @relation(fields: [patientId], references: [id], onDelete: Restrict)
  startsAt          DateTime           @map("starts_at") @db.Timestamptz(3)
  endsAt            DateTime           @map("ends_at") @db.Timestamptz(3)
  kind              AppointmentKind    @default(regular)
  status            AppointmentStatus  @default(scheduled)
  notes             String?            @db.VarChar(200)
  returnOfId        String?            @map("return_of_id") @db.Uuid
  rescheduledFromId String?            @unique @map("rescheduled_from_id") @db.Uuid
  rescheduledToId   String?            @unique @map("rescheduled_to_id") @db.Uuid
  cancelReason      String?            @map("cancel_reason") @db.VarChar(200)
  cancelRequestedBy String?            @map("cancel_requested_by") @db.VarChar(20)
  createdByUserId   String             @map("created_by_user_id") @db.Uuid
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  events            AppointmentEvent[]
  encounter         Encounter?
  charges           Charge[]
  messages          OutboundMessage[]

  @@index([scheduleId, startsAt])
  @@index([patientId, startsAt])
  @@map("appointments")
  @@schema("scheduling")
}

/// Histórico da consulta, somente-acréscimo.
model AppointmentEvent {
  id            String      @id @default(uuid(7)) @db.Uuid
  seq           BigInt      @unique @default(autoincrement())
  appointmentId String      @map("appointment_id") @db.Uuid
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  type          String      @db.VarChar(40)
  at            DateTime    @db.Timestamptz(3)
  byUserId      String      @map("by_user_id") @db.Uuid
  details       Json?

  @@index([appointmentId])
  @@map("appointment_events")
  @@schema("scheduling")
}

enum WaitlistStatus {
  waiting
  scheduled
  removed

  @@schema("scheduling")
}

model WaitlistEntry {
  id              String         @id @default(uuid(7)) @db.Uuid
  organizationId  String         @map("organization_id") @db.Uuid
  unitId          String         @map("unit_id") @db.Uuid
  unit            Unit           @relation(fields: [unitId], references: [id], onDelete: Restrict)
  patientId       String         @map("patient_id") @db.Uuid
  patient         Patient        @relation(fields: [patientId], references: [id], onDelete: Restrict)
  professionalId  String?        @map("professional_id") @db.Uuid
  professional    Professional?  @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  preference      String?        @db.VarChar(200)
  status          WaitlistStatus @default(waiting)
  appointmentId   String?        @unique @map("appointment_id") @db.Uuid
  removedReason   String?        @map("removed_reason") @db.VarChar(200)
  createdByUserId String         @map("created_by_user_id") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([unitId, status, createdAt])
  @@map("waitlist_entries")
  @@schema("scheduling")
}

enum EncounterStatus {
  started
  closed

  @@schema("care")
}

/// Atendimento: do início pelo médico, com o paciente na recepção, até o encerramento.
/// O banco impede dois atendimentos abertos do mesmo médico com o mesmo paciente (EXCLUDE).
model Encounter {
  id             String          @id @default(uuid(7)) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  unitId         String          @map("unit_id") @db.Uuid
  appointmentId  String          @unique @map("appointment_id") @db.Uuid
  appointment    Appointment     @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  patientId      String          @map("patient_id") @db.Uuid
  patient        Patient         @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctorUserId   String          @map("doctor_user_id") @db.Uuid
  status         EncounterStatus @default(started)
  startedAt      DateTime        @map("started_at") @db.Timestamptz(3)
  closedAt       DateTime?       @map("closed_at") @db.Timestamptz(3)
  followUpUntil  DateTime?       @map("follow_up_until") @db.Timestamptz(3)

  records   ClinicalRecord[]
  documents MedicalDocument[]

  @@index([doctorUserId, patientId])
  @@index([organizationId])
  @@map("encounters")
  @@schema("care")
}

enum EmergencyReviewOutcome {
  appropriate
  inappropriate

  @@schema("care")
}

/// Acesso emergencial ("quebra de vidro"). Nunca apagado; a revisão é gravada uma única vez.
model EmergencyAccess {
  id               String                  @id @default(uuid(7)) @db.Uuid
  organizationId   String                  @map("organization_id") @db.Uuid
  patientId        String                  @map("patient_id") @db.Uuid
  patient          Patient                 @relation(fields: [patientId], references: [id], onDelete: Restrict)
  userId           String                  @map("user_id") @db.Uuid
  justification    String                  @db.VarChar(1000)
  startsAt         DateTime                @map("starts_at") @db.Timestamptz(3)
  expiresAt        DateTime                @map("expires_at") @db.Timestamptz(3)
  reviewOutcome    EmergencyReviewOutcome? @map("review_outcome")
  reviewNotes      String?                 @map("review_notes") @db.VarChar(1000)
  reviewedAt       DateTime?               @map("reviewed_at") @db.Timestamptz(3)
  reviewedByUserId String?                 @map("reviewed_by_user_id") @db.Uuid

  @@index([userId, patientId, expiresAt])
  @@index([organizationId, reviewedAt])
  @@map("emergency_accesses")
  @@schema("care")
}

enum RecordKind {
  consultation
  evolution
  addendum

  @@schema("records")
}

enum RecordStatus {
  draft
  finalized
  signed
  rectified
  archived
  discarded

  @@schema("records")
}

enum RecordSensitivity {
  normal
  elevated
  restricted

  @@schema("records")
}

/// Registro clínico. Depois de assinado, o conteúdo fica congelado por gatilho no banco.
model ClinicalRecord {
  id                String            @id @default(uuid(7)) @db.Uuid
  organizationId    String            @map("organization_id") @db.Uuid
  patientId         String            @map("patient_id") @db.Uuid
  patient           Patient           @relation(fields: [patientId], references: [id], onDelete: Restrict)
  authorUserId      String            @map("author_user_id") @db.Uuid
  encounterId       String?           @map("encounter_id") @db.Uuid
  encounter         Encounter?        @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  unitId            String?           @map("unit_id") @db.Uuid
  kind              RecordKind        @default(consultation)
  clinicalDate      DateTime          @map("clinical_date") @db.Date
  sensitivity       RecordSensitivity @default(normal)
  status            RecordStatus      @default(draft)
  version           Int               @default(1)
  formVersion       String            @default("generic-v1") @map("form_version") @db.VarChar(40)
  content           Json
  /// Já esteve finalizado alguma vez (rascunho assim não pode ser descartado).
  everFinalized     Boolean           @default(false) @map("ever_finalized")
  contentHash       String?           @map("content_hash") @db.Char(64)
  signedAt          DateTime?         @map("signed_at") @db.Timestamptz(3)
  signatureEvidence Json?             @map("signature_evidence")
  rectifiesId       String?           @map("rectifies_id") @db.Uuid
  rectifiedById     String?           @unique @map("rectified_by_id") @db.Uuid
  addendumOfId      String?           @map("addendum_of_id") @db.Uuid
  justification     String?           @db.VarChar(1000)
  archivedAt        DateTime?         @map("archived_at") @db.Timestamptz(3)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  versions          RecordVersion[]
  events            RecordEvent[]

  @@index([patientId, clinicalDate])
  @@index([authorUserId])
  @@index([rectifiesId])
  @@index([addendumOfId])
  @@map("clinical_records")
  @@schema("records")
}

/// Versões salvas do rascunho, somente-acréscimo.
model RecordVersion {
  id            String         @id @default(uuid(7)) @db.Uuid
  recordId      String         @map("record_id") @db.Uuid
  record        ClinicalRecord @relation(fields: [recordId], references: [id], onDelete: Restrict)
  version       Int
  content       Json
  savedAt       DateTime       @map("saved_at") @db.Timestamptz(3)
  savedByUserId String         @map("saved_by_user_id") @db.Uuid

  @@unique([recordId, version])
  @@map("record_versions")
  @@schema("records")
}

/// Histórico de estados do registro, somente-acréscimo.
model RecordEvent {
  id       String         @id @default(uuid(7)) @db.Uuid
  seq      BigInt         @unique @default(autoincrement())
  recordId String         @map("record_id") @db.Uuid
  record   ClinicalRecord @relation(fields: [recordId], references: [id], onDelete: Restrict)
  type     String         @db.VarChar(40)
  at       DateTime       @db.Timestamptz(3)
  byUserId String         @map("by_user_id") @db.Uuid
  details  Json?

  @@index([recordId])
  @@map("record_events")
  @@schema("records")
}

/// Justificativas para abrir registros sensíveis de outros autores, somente-acréscimo.
model AccessJustification {
  id            String   @id @default(uuid(7)) @db.Uuid
  recordId      String   @map("record_id") @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  justification String   @db.VarChar(1000)
  at            DateTime @db.Timestamptz(3)

  @@index([recordId])
  @@map("access_justifications")
  @@schema("records")
}

enum DocumentKind {
  prescription
  certificate
  exam_request
  referral
  report

  @@schema("documents")
}

enum DocumentStatus {
  draft
  signed
  cancelled
  discarded

  @@schema("documents")
}

/// Documento médico (receita, atestado, pedido, encaminhamento, relatório). Depois de assinado,
/// fica congelado por gatilho no banco (docs/api/documentos.md).
model MedicalDocument {
  id                String          @id @default(uuid(7)) @db.Uuid
  organizationId    String          @map("organization_id") @db.Uuid
  patientId         String          @map("patient_id") @db.Uuid
  patient           Patient         @relation(fields: [patientId], references: [id], onDelete: Restrict)
  authorUserId      String          @map("author_user_id") @db.Uuid
  encounterId       String?         @map("encounter_id") @db.Uuid
  encounter         Encounter?      @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  unitId            String?         @map("unit_id") @db.Uuid
  kind              DocumentKind
  status            DocumentStatus  @default(draft)
  version           Int             @default(1)
  content           Json
  /// Emitente, paciente e local no momento da assinatura.
  snapshot          Json?
  /// Data de emissão, local da unidade.
  issuedOn          DateTime?       @map("issued_on") @db.Date
  contentHash       String?         @map("content_hash") @db.Char(64)
  signedAt          DateTime?       @map("signed_at") @db.Timestamptz(3)
  signatureEvidence Json?           @map("signature_evidence")
  cancelledAt       DateTime?       @map("cancelled_at") @db.Timestamptz(3)
  cancelledByUserId String?         @map("cancelled_by_user_id") @db.Uuid
  cancelReason      String?         @map("cancel_reason") @db.VarChar(1000)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  events            DocumentEvent[]

  @@index([patientId, createdAt])
  @@index([authorUserId])
  @@map("medical_documents")
  @@schema("documents")
}

/// Histórico de estados do documento, somente-acréscimo.
model DocumentEvent {
  id         String          @id @default(uuid(7)) @db.Uuid
  seq        BigInt          @unique @default(autoincrement())
  documentId String          @map("document_id") @db.Uuid
  document   MedicalDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)
  type       String          @db.VarChar(40)
  at         DateTime        @db.Timestamptz(3)
  byUserId   String          @map("by_user_id") @db.Uuid
  details    Json?

  @@index([documentId])
  @@map("document_events")
  @@schema("documents")
}

/// Item da tabela de preços (atendimento particular, docs/api/financeiro.md).
model PriceItem {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String   @db.VarChar(120)
  amountCents    Int      @map("amount_cents")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  charges        Charge[]

  @@unique([organizationId, name])
  @@map("price_items")
  @@schema("billing")
}

/// Cobrança ao paciente. Valor e desconto não mudam; corrige-se cancelando.
model Charge {
  id              String       @id @default(uuid(7)) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  unitId          String       @map("unit_id") @db.Uuid
  patientId       String       @map("patient_id") @db.Uuid
  patient         Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  appointmentId   String?      @map("appointment_id") @db.Uuid
  appointment     Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  priceItemId     String?      @map("price_item_id") @db.Uuid
  priceItem       PriceItem?   @relation(fields: [priceItemId], references: [id], onDelete: Restrict)
  description     String       @db.VarChar(200)
  amountCents     Int          @map("amount_cents")
  discountCents   Int          @default(0) @map("discount_cents")
  cancelledAt     DateTime?    @map("cancelled_at") @db.Timestamptz(3)
  cancelledById   String?      @map("cancelled_by_id") @db.Uuid
  cancelReason    String?      @map("cancel_reason") @db.VarChar(200)
  createdByUserId String       @map("created_by_user_id") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  payments        Payment[]

  @@index([organizationId, unitId, createdAt])
  @@index([patientId])
  @@map("charges")
  @@schema("billing")
}

enum PaymentMethod {
  cash
  pix
  debit_card
  credit_card
  other

  @@schema("billing")
}

/// Pagamento recebido. Não muda; só pode ser estornado (docs/api/financeiro.md).
model Payment {
  id               String        @id @default(uuid(7)) @db.Uuid
  organizationId   String        @map("organization_id") @db.Uuid
  chargeId         String        @map("charge_id") @db.Uuid
  charge           Charge        @relation(fields: [chargeId], references: [id], onDelete: Restrict)
  method           PaymentMethod
  amountCents      Int           @map("amount_cents")
  paidAt           DateTime      @map("paid_at") @db.Timestamptz(3)
  receivedByUserId String        @map("received_by_user_id") @db.Uuid
  idempotencyKey   String        @map("idempotency_key") @db.VarChar(100)
  /// SHA-256 do pedido original, para recusar a mesma chave com outros dados.
  requestHash      String        @map("request_hash") @db.Char(64)
  reversedAt       DateTime?     @map("reversed_at") @db.Timestamptz(3)
  reversedById     String?       @map("reversed_by_id") @db.Uuid
  reverseReason    String?       @map("reverse_reason") @db.VarChar(200)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([organizationId, idempotencyKey])
  @@index([chargeId])
  @@index([organizationId, paidAt])
  @@map("payments")
  @@schema("billing")
}

enum SubjectRequestKind {
  access
  access_report
  correction
  portability
  deletion
  sharing_info
  other

  @@schema("privacy")
}

enum SubjectRequestStatus {
  open
  completed
  denied

  @@schema("privacy")
}

/// Pedido do titular dos dados (LGPD art. 18). Não é apagado; a resposta é gravada uma vez
/// (docs/api/direitos-do-titular.md).
model SubjectRequest {
  id               String               @id @default(uuid(7)) @db.Uuid
  organizationId   String               @map("organization_id") @db.Uuid
  patientId        String               @map("patient_id") @db.Uuid
  patient          Patient              @relation(fields: [patientId], references: [id], onDelete: Restrict)
  kind             SubjectRequestKind
  details          String?              @db.VarChar(1000)
  status           SubjectRequestStatus @default(open)
  dueOn            DateTime             @map("due_on") @db.Date
  createdByUserId  String               @map("created_by_user_id") @db.Uuid
  createdAt        DateTime             @map("created_at") @db.Timestamptz(3)
  resolvedByUserId String?              @map("resolved_by_user_id") @db.Uuid
  resolvedAt       DateTime?            @map("resolved_at") @db.Timestamptz(3)
  resolution       String?              @db.VarChar(1000)

  @@index([organizationId, status, dueOn])
  @@index([patientId])
  @@map("subject_requests")
  @@schema("privacy")
}

// CRM e lembretes (docs/api/crm-e-lembretes.md). A autorização do paciente é a preferência de
// comunicação do cadastro (patients.patients.comm_channels e appointment_reminders).

enum MessageKind {
  appointment_reminder

  @@schema("crm")
}

enum MessageStatus {
  queued
  sent
  failed
  cancelled

  @@schema("crm")
}

/// Mensagem para o paciente. Texto e número ficam como foram gerados.
model OutboundMessage {
  id                String        @id @default(uuid(7)) @db.Uuid
  organizationId    String        @map("organization_id") @db.Uuid
  unitId            String        @map("unit_id") @db.Uuid
  patientId         String        @map("patient_id") @db.Uuid
  patient           Patient       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  appointmentId     String        @map("appointment_id") @db.Uuid
  appointment       Appointment   @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  kind              MessageKind
  channel           CommChannel
  toNumber          String        @map("to_number") @db.VarChar(11)
  body              String        @db.VarChar(1000)
  status            MessageStatus @default(queued)
  scheduledFor      DateTime      @map("scheduled_for") @db.Timestamptz(3)
  attempts          Int           @default(0)
  sentAt            DateTime?     @map("sent_at") @db.Timestamptz(3)
  providerRef       String?       @map("provider_ref") @db.VarChar(100)
  lastError         String?       @map("last_error") @db.VarChar(300)
  cancelledByUserId String?       @map("cancelled_by_user_id") @db.Uuid
  cancelReason      String?       @map("cancel_reason") @db.VarChar(200)
  createdAt         DateTime      @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @map("updated_at") @db.Timestamptz(3)

  @@unique([appointmentId, kind])
  @@index([status, scheduledFor])
  @@index([organizationId, unitId, scheduledFor])
  @@index([patientId])
  @@map("messages")
  @@schema("crm")
}

// IA nível 1, administrativa (docs/api/ia-nivel-1.md).

enum AiFeature {
  message_draft
  request_triage
  schedule_suggestions
  admin_report

  @@schema("ai")
}

enum AiDecision {
  draft
  accepted
  discarded

  @@schema("ai")
}

/// Interruptor de cada funcionalidade de IA por organização. Sem linha = desligada.
model AiFeatureSetting {
  organizationId  String       @map("organization_id") @db.Uuid
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  feature         AiFeature
  enabled         Boolean
  updatedByUserId String       @map("updated_by_user_id") @db.Uuid
  updatedBy       User         @relation(fields: [updatedByUserId], references: [id], onDelete: Restrict)
  updatedAt       DateTime     @map("updated_at") @db.Timestamptz(3)

  @@id([organizationId, feature])
  @@map("feature_settings")
  @@schema("ai")
}

/// Um uso da IA. Guarda resumo e tamanho da entrada, nunca a entrada; a decisão humana só uma vez.
model AiRequest {
  id              String       @id @default(uuid(7)) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  userId          String       @map("user_id") @db.Uuid
  user            User         @relation("AiRequestUser", fields: [userId], references: [id], onDelete: Restrict)
  feature         AiFeature
  purpose         String       @db.VarChar(60)
  provider        String       @db.VarChar(40)
  model           String       @db.VarChar(80)
  modelVersion    String       @map("model_version") @db.VarChar(40)
  inputSha256     String       @map("input_sha256") @db.Char(64)
  inputChars      Int          @map("input_chars")
  output          String       @db.VarChar(4000)
  /// Campos estruturados da saída (por exemplo, categoria da classificação).
  outputMeta      Json         @default("{}") @map("output_meta")
  decision        AiDecision   @default(draft)
  edited          Boolean?
  decidedByUserId String?      @map("decided_by_user_id") @db.Uuid
  decidedBy       User?        @relation("AiRequestDecidedBy", fields: [decidedByUserId], references: [id], onDelete: Restrict)
  decidedAt       DateTime?    @map("decided_at") @db.Timestamptz(3)
  createdAt       DateTime     @map("created_at") @db.Timestamptz(3)

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
  @@map("requests")
  @@schema("ai")
}
