// Esquema do banco. Cada módulo do sistema tem seu próprio schema no PostgreSQL
// (ver docs/planejamento/03-arquitetura.md, seção 2). Toda alteração vira uma
// migração versionada em prisma/migrations.

generator client {
  provider            = "prisma-client"
  output              = "../apps/api/src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["org", "identity", "audit", "patients"]
}

/// Organização (pessoa jurídica controladora dos dados).
model Organization {
  id            String         @id @default(uuid(7)) @db.Uuid
  name          String         @db.VarChar(200)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  units         Unit[]
  users         User[]
  specialties   Specialty[]
  professionals Professional[]
  patients      Patient[]

  @@map("organizations")
  @@schema("org")
}

/// Unidade de atendimento. Todo dado operacional carrega o id da unidade.
model Unit {
  id             String           @id @default(uuid(7)) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name           String           @db.VarChar(200)
  timezone       String           @default("America/Sao_Paulo") @db.VarChar(64)
  active         Boolean          @default(true)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  memberships    UnitMembership[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("units")
  @@schema("org")
}

enum Role {
  doctor
  secretary
  admin

  @@schema("identity")
}

/// Pessoa que acessa o sistema. Senha guardada só como hash Argon2id.
model User {
  id                 String           @id @default(uuid(7)) @db.Uuid
  organizationId     String           @map("organization_id") @db.Uuid
  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name               String           @db.VarChar(200)
  /// Sempre em minúsculas.
  email              String           @unique @db.VarChar(254)
  passwordHash       String           @map("password_hash") @db.VarChar(255)
  roles              Role[]
  active             Boolean          @default(true)
  mustChangePassword Boolean          @default(false) @map("must_change_password")
  /// Segredo TOTP criptografado com AES-256-GCM (nunca em texto puro).
  mfaSecretEnc       String?          @map("mfa_secret_enc") @db.VarChar(255)
  mfaEnabled         Boolean          @default(false) @map("mfa_enabled")
  /// Último passo de 30 s aceito; impede reutilizar o mesmo código.
  mfaLastStep        BigInt?          @map("mfa_last_step")
  failedLoginCount   Int              @default(0) @map("failed_login_count")
  lockedUntil        DateTime?        @map("locked_until") @db.Timestamptz(3)
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions           Session[]
  unitMemberships    UnitMembership[]
  professional       Professional?

  @@index([organizationId])
  @@map("users")
  @@schema("identity")
}

/// Sessão de login. Guarda apenas o hash do token; o token fica só no cookie do navegador.
model Session {
  id          String    @id @default(uuid(7)) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique @map("token_hash") @db.Char(64)
  csrfToken   String    @map("csrf_token") @db.VarChar(64)
  mfaVerified Boolean   @default(false) @map("mfa_verified")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt  DateTime  @map("last_seen_at") @db.Timestamptz(3)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)
  reauthAt    DateTime? @map("reauth_at") @db.Timestamptz(3)
  ip          String?   @db.VarChar(64)
  userAgent   String?   @map("user_agent") @db.VarChar(400)

  @@index([userId])
  @@map("sessions")
  @@schema("identity")
}

/// Vínculo de um usuário com uma unidade. Recursos operacionais da unidade exigem este vínculo.
model UnitMembership {
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  unitId    String   @map("unit_id") @db.Uuid
  unit      Unit     @relation(fields: [unitId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([userId, unitId])
  @@index([unitId])
  @@map("unit_memberships")
  @@schema("org")
}

/// Especialidade médica do catálogo da organização.
model Specialty {
  id             String                  @id @default(uuid(7)) @db.Uuid
  organizationId String                  @map("organization_id") @db.Uuid
  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name           String                  @db.VarChar(120)
  active         Boolean                 @default(true)
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  professionals  ProfessionalSpecialty[]

  @@unique([organizationId, name])
  @@map("specialties")
  @@schema("org")
}

/// Ficha profissional de um usuário médico: CRM/UF e especialidades com RQE.
model Professional {
  id             String                  @id @default(uuid(7)) @db.Uuid
  organizationId String                  @map("organization_id") @db.Uuid
  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  userId         String                  @unique @map("user_id") @db.Uuid
  user           User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  /// Só dígitos.
  crmNumber      String                  @map("crm_number") @db.VarChar(10)
  /// Sigla da UF em maiúsculas.
  crmState       String                  @map("crm_state") @db.Char(2)
  active         Boolean                 @default(true)
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  specialties    ProfessionalSpecialty[]

  @@unique([organizationId, crmState, crmNumber])
  @@map("professionals")
  @@schema("org")
}

model ProfessionalSpecialty {
  professionalId String       @map("professional_id") @db.Uuid
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  specialtyId    String       @map("specialty_id") @db.Uuid
  specialty      Specialty    @relation(fields: [specialtyId], references: [id], onDelete: Restrict)
  /// Registro de Qualificação de Especialista, quando houver. Só dígitos.
  rqe            String?      @db.VarChar(10)

  @@id([professionalId, specialtyId])
  @@index([specialtyId])
  @@map("professional_specialties")
  @@schema("org")
}

enum AuditOutcome {
  allowed
  denied
  not_found

  @@schema("audit")
}

/// Trilha de auditoria somente-acréscimo (um gatilho recusa UPDATE e DELETE).
/// Referencia tudo por id, sem chaves estrangeiras, para sobreviver a qualquer outro dado.
/// Nunca guarda conteúdo clínico.
model AuditEvent {
  id             String       @id @default(uuid(7)) @db.Uuid
  /// Ordem de gravação, estritamente crescente (base do encadeamento por hash na Etapa 7).
  seq            BigInt       @unique @default(autoincrement())
  occurredAt     DateTime     @map("occurred_at") @db.Timestamptz(3)
  organizationId String?      @map("organization_id") @db.Uuid
  actorUserId    String?      @map("actor_user_id") @db.Uuid
  sessionId      String?      @map("session_id") @db.Uuid
  requestId      String?      @map("request_id") @db.VarChar(64)
  ip             String?      @db.VarChar(64)
  action         String       @db.VarChar(32)
  resourceType   String       @map("resource_type") @db.VarChar(64)
  resourceId     String?      @map("resource_id") @db.VarChar(64)
  unitId         String?      @map("unit_id") @db.Uuid
  patientId      String?      @map("patient_id") @db.Uuid
  outcome        AuditOutcome
  reason         String       @db.VarChar(100)
  emergency      Boolean      @default(false)

  @@index([organizationId, occurredAt])
  @@index([actorUserId, occurredAt])
  @@map("events")
  @@schema("audit")
}

enum CommChannel {
  whatsapp
  sms
  email
  phone

  @@schema("patients")
}

/// Cadastro do paciente (dado pessoal, nunca clínico). Ver docs/api/pacientes.md.
model Patient {
  id                   String           @id @default(uuid(7)) @db.Uuid
  organizationId       String           @map("organization_id") @db.Uuid
  organization         Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  fullName             String           @map("full_name") @db.VarChar(200)
  socialName           String?          @map("social_name") @db.VarChar(200)
  /// Nome completo e social sem acentos, em minúsculas, para a busca.
  nameSearch           String           @map("name_search") @db.VarChar(410)
  /// CPF criptografado (AES-256-GCM). Nunca em texto puro.
  cpfEnc               String?          @map("cpf_enc") @db.VarChar(255)
  /// HMAC-SHA256 do CPF: impede repetição e permite busca exata.
  cpfHash              String?          @map("cpf_hash") @db.Char(64)
  birthDate            DateTime         @map("birth_date") @db.Date
  email                String?          @db.VarChar(254)
  addressZip           String?          @map("address_zip") @db.Char(8)
  addressStreet        String?          @map("address_street") @db.VarChar(200)
  addressNumber        String?          @map("address_number") @db.VarChar(20)
  addressComplement    String?          @map("address_complement") @db.VarChar(100)
  addressDistrict      String?          @map("address_district") @db.VarChar(100)
  addressCity          String?          @map("address_city") @db.VarChar(100)
  addressState         String?          @map("address_state") @db.Char(2)
  commChannels         CommChannel[]    @default([]) @map("comm_channels")
  appointmentReminders Boolean          @default(false) @map("appointment_reminders")
  marketingOptIn       Boolean          @default(false) @map("marketing_opt_in")
  active               Boolean          @default(true)
  version              Int              @default(1)
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  phones               PatientPhone[]
  contacts             PatientContact[]
  versions             PatientVersion[]

  @@unique([organizationId, cpfHash])
  @@index([organizationId, birthDate])
  @@index([organizationId, nameSearch])
  @@map("patients")
  @@schema("patients")
}

model PatientPhone {
  id        String  @id @default(uuid(7)) @db.Uuid
  patientId String  @map("patient_id") @db.Uuid
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  /// DDD + número, só dígitos.
  number    String  @db.VarChar(11)
  whatsapp  Boolean @default(false)
  position  Int

  @@unique([patientId, position])
  @@index([number])
  @@map("phones")
  @@schema("patients")
}

enum PatientContactKind {
  guardian
  emergency

  @@schema("patients")
}

/// Responsável legal ou contato de emergência.
model PatientContact {
  id           String             @id @default(uuid(7)) @db.Uuid
  patientId    String             @map("patient_id") @db.Uuid
  patient      Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  kind         PatientContactKind
  name         String             @db.VarChar(200)
  relationship String             @db.VarChar(60)
  phone        String?            @db.VarChar(11)
  email        String?            @db.VarChar(254)
  position     Int

  @@unique([patientId, kind, position])
  @@map("contacts")
  @@schema("patients")
}

/// Versões do cadastro, somente-acréscimo (um gatilho recusa UPDATE e DELETE).
model PatientVersion {
  id              String   @id @default(uuid(7)) @db.Uuid
  patientId       String   @map("patient_id") @db.Uuid
  patient         Patient  @relation(fields: [patientId], references: [id], onDelete: Restrict)
  version         Int
  changedAt       DateTime @map("changed_at") @db.Timestamptz(3)
  changedByUserId String   @map("changed_by_user_id") @db.Uuid
  changedFields   String[] @map("changed_fields")
  /// Fotografia do cadastro após a alteração, sem o CPF.
  snapshot        Json

  @@unique([patientId, version])
  @@map("versions")
  @@schema("patients")
}
